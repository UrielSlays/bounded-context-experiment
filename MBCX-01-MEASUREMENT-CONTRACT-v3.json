{
  "contract_id": "MBCX-01-MEASUREMENT-CONTRACT-v3",
  "normative": true,
  "claim_scope": "registered physical work is bounded over the complete frozen finite H, D, and F Cartesian product; no universal asymptotic claim",
  "counter_set_closed": true,
  "axis_values": {
    "H": [128, 1024, 10000, 100000],
    "D": [1, 4, 16, 64, 256],
    "F": [1, 4, 16, 64, 256]
  },
  "required_cells": {
    "kind": "FULL_CARTESIAN_PRODUCT",
    "unique_cell_count": 100,
    "duplicates_removed_by_exact_tuple": false
  },
  "storage": {
    "backend": "SQLite 3 rollback-journal mode on local NTFS",
    "database_page_size_bytes": 4096,
    "filesystem_allocation_unit_bytes": 4096,
    "page_read_equation": "PAGES_READ = ceil(DATABASE_BYTES_READ / 4096)",
    "page_write_equation": "PAGES_WRITTEN = ceil(DATABASE_BYTES_WRITTEN / 4096)",
    "backend_or_page_size_change": "DESIGN_OR_IMPLEMENTATION_FAIL"
  },
  "sampling_boundary": {
    "start": "before candidate config parse, candidate-specific preprocessing, process spawn, artifact open, or dependency initialization",
    "stop": "after packet bytes are durable, all descendants exit, background work quiesces, artifacts close, and counters flush",
    "descendants": "all descendant PIDs and their filesystem, database, CPU, memory, and allocation work are charged to the candidate",
    "unregistered_work": "DESIGN_OR_IMPLEMENTATION_FAIL"
  },
  "counter_row_schema": {
    "required": ["candidate_id", "H", "D", "F", "database_page_size_bytes", "descendant_accounted", "unregistered_work", "counters"],
    "additionalProperties": false,
    "counter_values": "nonnegative safe integers",
    "coverage": "exactly one row for each of the 100 registered cells"
  },
  "counter_catalog": [
    {"id": "SOURCE_BYTES_READ", "unit_class": "bytes", "H_range_max": 4096, "D_range_max": 4096, "F_range_max": 4096, "absolute_max": 16384},
