  "shape_gates": [
    {"error": "H_SHAPE_LIMIT", "counter_id": "PROCESS_CPU_INSTRUCTIONS", "axis": "H", "lower": 10000, "upper": 100000, "max_increase": 500000},
    {"error": "D_SHAPE_LIMIT", "counter_id": "DATABASE_BYTES_READ", "axis": "D", "lower": 64, "upper": 256, "max_increase": 524288}
  ],
  "aggregation": {
    "per_counter": "for each axis, hold the other two axes fixed and compute max minus min",
    "unit_total": "sum all registered counters in a unit at each cell, then apply the same conditional axis ranges",
    "absolute": "every literal counter and same-unit cell total must be at or below its preregistered maximum",
    "zero_growth_branches": "both branch counters have exact H, D, and F range zero",
    "new_renamed_or_missing_counter": "DESIGN_OR_IMPLEMENTATION_FAIL"
  },
  "source_and_cohort_freeze": {
    "order": ["generator_spec_hash", "distribution_parameters_hash", "gold_enumerator_hash", "eligibility_evaluator_hash", "candidate_source_hashes", "candidate_build_hashes", "candidate_dependency_hashes", "candidate_config_hashes", "fresh_confirmatory_seed", "generated_candidates", "one_cut_selection", "eligibility_recomputation", "retained_manifest"],
    "instrument_freeze_before_candidate_inspection": true,
    "candidate_freeze_before_confirmatory_seed": true,
    "confirmatory_seed_candidate_readable": false,
    "motifs": ["CORRECTION_RESTORATION", "OBLIGATION_LIFECYCLE", "DEPENDENCY_REVERSAL", "CROSS_SCOPE_COLLISION", "DELEGATION_IDEMPOTENT_HANDOFF", "MIXED_DELAYED_CONTINUITY"],
    "generated_unique_scenarios_per_motif": 160,
    "retained_unique_scenarios_per_motif": 128,
    "one_cut_hash": "SHA-256 over 8-byte big-endian length-framed UTF-8 parts: scenario_id, every UTF8-sorted cut_id, stage2-cut-r9; integer digest modulo cut count",
    "retention_hash": "SHA-256 over length-framed motif, scenario_id, chosen_cut_id, stage2-retain-r9",
    "eligibility": "recompute from canonical state at the chosen cut: exactly one mounted OPEN critical obligation due by valid_time, its completion action is the unique gold action, and at least one distinct non-gold action is available",
    "supplied_eligibility_boolean": "REJECT_AS_INPUT_AND_IGNORE",
    "selection_order": "choose one cut before recomputing eligibility; retain first 64 eligible unique scenario IDs by retention hash",
    "shortfall": "DESIGN_OR_IMPLEMENTATION_FAIL",
    "estimand_population": "conditional on the frozen eligible retained manifest; no unbiased-sampling claim",
    "publish": ["all candidate scenario IDs", "chosen cut", "recomputed eligibility result and reason", "motif", "difficulty stratum", "retention hash"]
  },
  "red_candidates": {
