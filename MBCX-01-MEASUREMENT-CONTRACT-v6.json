{
  "contract_id": "MBCX-01-MEASUREMENT-CONTRACT-v6",
  "normative": true,
  "cohort": {
    "motifs": 6,
    "source_scenarios_per_motif": 160,
    "retained_per_motif": 128,
    "retained_total": 768,
    "one_cut_hash_domain": "stage2-cut-r12",
    "retention_hash_domain": "stage2-retain-r12",
    "authority": "SourceProvenanceManifestV1 binds generator digest and every scenario motif, complete cut set, and action universe"
  },
  "grid": {
    "H": [128, 1024, 10000, 100000],
    "D": [1, 4, 16, 64, 256],
    "F": [1, 4, 16, 64, 256],
    "cells": 100,
    "integer_rule": "exact integers; JSON/Python Booleans are rejected",
    "identity_rule": "one signed run, candidate ID and generator digest across all cells"
  },
  "signed_measurement_envelope": {
    "schema_id": "SignedMeasurementReceiptV1",
    "domain": "MBCX01.SIGNED-MEASUREMENT-RECEIPT.V1",
    "version": 1,
    "algorithm": "ED25519",
    "signed_preimage": ["domain", "version", "algorithm", "signing_key_id", "run_id", "cell_id", "fixture_kind", "receipt"],
    "digest": "uppercase SHA-384 over canonical signed-preimage bytes",
    "anti_replay": "run_id and exact CELL.H{H}.D{D}.F{F} are inside the signature and checked against evaluator inputs",
    "trust_root": "signing_key_id resolves only through separately pinned MBCX-01-R12-MEASUREMENT-TRUST-ROOTS.json; its closed document has production_ready=false and only fixture_only=true roots; envelope-supplied keys are forbidden; test key IDs can never authenticate PHYSICAL_HARNESS_RECEIPT",
    "test_key": "private key exists only in the nonnormative test artifact; runtime owns only its public key, test signatures exercise admission only, and always retain PHYSICAL_HARNESS_UNAVAILABLE"
  },
  "signed_measurement_envelope_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://moonwalker.local/schema/mbcx01/r12/signed-measurement-receipt-v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_id", "domain", "version", "algorithm", "signing_key_id", "run_id", "cell_id", "receipt", "receipt_preimage_b64", "receipt_digest", "signature_b64", "fixture_kind"],
    "properties": {
      "schema_id": {"const": "SignedMeasurementReceiptV1"},
      "domain": {"const": "MBCX01.SIGNED-MEASUREMENT-RECEIPT.V1"},
      "version": {"const": 1},
      "algorithm": {"const": "ED25519"},
      "signing_key_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9:._/-]{0,127}$"},
      "run_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9:._/-]{0,127}$"},
      "cell_id": {"type": "string", "pattern": "^CELL\\.H(128|1024|10000|100000)\\.D(1|4|16|64|256)\\.F(1|4|16|64|256)$"},
      "receipt": {"$ref": "#/$defs/measurementReceiptV2"},
      "receipt_preimage_b64": {"type": "string", "minLength": 1, "contentEncoding": "base64"},
      "receipt_digest": {"type": "string", "pattern": "^[0-9A-F]{96}$"},
      "signature_b64": {"type": "string", "minLength": 1, "contentEncoding": "base64"},
      "fixture_kind": {"enum": ["NO_PAID_TEST_FIXTURE", "PHYSICAL_HARNESS_RECEIPT"]}
    },
    "$defs": {
      "measurementReceiptV2": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_id", "candidate_id", "generator_digest", "H", "D", "F", "external_work_policy", "job_receipt"],
        "properties": {
          "schema_id": {"const": "MeasurementReceiptV2"},
          "candidate_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9:._/-]{0,127}$"},
          "generator_digest": {"type": "string", "pattern": "^[0-9A-F]{96}$"},
          "H": {"enum": [128, 1024, 10000, 100000]},
          "D": {"enum": [1, 4, 16, 64, 256]},
          "F": {"enum": [1, 4, 16, 64, 256]},
          "external_work_policy": {"const": "NETWORK_EGRESS_DENIED_NO_EXTERNAL_COMPUTE"},
          "job_receipt": {"$ref": "#/$defs/jobReceiptV2"}
        }
      },
      "jobReceiptV2": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receipt_source", "job_object_id", "root_process_id", "created_suspended", "completion_port_associated_before_resume", "assigned_before_resume", "breakaway_enabled", "silent_breakaway_enabled", "active_processes_at_final_query", "completion_port_drained", "user_time_ns", "kernel_time_ns", "read_operations", "write_operations", "other_operations", "read_transfer_bytes", "write_transfer_bytes", "other_transfer_bytes", "peak_committed_bytes", "elapsed_monotonic_ns", "retired_instructions", "instruction_backend", "instruction_profile_source", "instruction_event_list", "instruction_attribution", "etw_capability_query_succeeded", "etw_pmc_source_available", "etw_max_pmc_counters", "etw_counter_owner_conflict_count", "etw_pmc_strict_mode", "etw_pmc_multiplexing_detected", "etw_events_lost", "etw_log_buffers_lost", "etw_realtime_buffers_lost", "etw_attribution_complete"],
        "properties": {
          "receipt_source": {"const": "WINDOWS_JOB_OBJECT_HARNESS_V2"},
          "job_object_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9:._/-]{0,127}$"},
          "root_process_id": {"type": "integer", "minimum": 1},
          "created_suspended": {"const": true},
          "completion_port_associated_before_resume": {"const": true},
          "assigned_before_resume": {"const": true},
          "breakaway_enabled": {"const": false},
          "silent_breakaway_enabled": {"const": false},
          "active_processes_at_final_query": {"const": 0},
          "completion_port_drained": {"const": true},
          "user_time_ns": {"type": "integer", "minimum": 0},
          "kernel_time_ns": {"type": "integer", "minimum": 0},
          "read_operations": {"type": "integer", "minimum": 0},
          "write_operations": {"type": "integer", "minimum": 0},
          "other_operations": {"type": "integer", "minimum": 0},
          "read_transfer_bytes": {"type": "integer", "minimum": 0},
          "write_transfer_bytes": {"type": "integer", "minimum": 0},
          "other_transfer_bytes": {"type": "integer", "minimum": 0},
          "peak_committed_bytes": {"type": "integer", "minimum": 0},
          "elapsed_monotonic_ns": {"type": "integer", "minimum": 1},
          "retired_instructions": {"type": "integer", "minimum": 1},
          "instruction_backend": {"const": "ETW_PMC_EVENT_ATTACHED_V1"},
          "instruction_profile_source": {"const": "INSTRUCTIONRETIRED"},
          "instruction_event_list": {"const": "CSWITCH"},
          "instruction_attribution": {"const": "SUM_INSTRUCTIONRETIRED_CSWITCH_DELTAS_BY_OLD_THREAD_JOINED_TO_SIGNED_JOB_PID_TID_LIFETIMES_INCLUDING_TERMINATED"},
          "etw_capability_query_succeeded": {"const": true},
          "etw_pmc_source_available": {"const": true},
          "etw_max_pmc_counters": {"type": "integer", "minimum": 1},
          "etw_counter_owner_conflict_count": {"const": 0},
          "etw_pmc_strict_mode": {"const": true},
          "etw_pmc_multiplexing_detected": {"const": false},
          "etw_events_lost": {"const": 0},
          "etw_log_buffers_lost": {"const": 0},
          "etw_realtime_buffers_lost": {"const": 0},
          "etw_attribution_complete": {"const": true}
        }
      }
    }
  },
  "physical_receipt": {
    "implementation_status": "PHYSICAL_HARNESS_UNAVAILABLE",
    "source": "WINDOWS_JOB_OBJECT_HARNESS_V2",
    "containment": "create root suspended, associate completion port and assign to job before resume; neither breakaway flag enabled",
    "completion": "active-process-zero, drained completion port, then final basic/I-O and extended-limit accounting queries",
    "job_aggregates": ["user/kernel CPU ns", "read/write/other operations", "read/write/other transfer bytes", "peak committed bytes", "monotonic elapsed ns"],
    "external_work": "network egress denied and no external compute, else EXTERNAL_WORK_UNMEASURED"
  },
  "retired_instruction_mode": {
    "status": "required; unsupported or incomplete is a hard failure, never diagnostic-only",
    "backend": "ETW_PMC_EVENT_ATTACHED_V1",
    "profile_source": "INSTRUCTIONRETIRED",
    "event_list": "CSWITCH",
    "collection_semantics": "TracePmcCounterListInfo InstructionRetired attached to TracePmcEventListInfo CSwitch in strict mode; sampled PmcProfile estimates and multiplexed counters are not interchangeable",
    "attribution": "sum consecutive InstructionRetired counter deltas at CSwitch to the outgoing OldThreadId on that processor, joined to signed Job-member PID/TID lifetimes including terminated processes",
    "capability_evidence": ["ETW query succeeded", "InstructionRetired source available", "maximum PMC counters >= 1", "zero owner conflicts", "strict mode true", "multiplexing detected false"],
    "loss_evidence": ["EventsLost=0", "LogBuffersLost=0", "RealTimeBuffersLost=0"],
    "fatal": ["INSTRUCTION_ACCOUNTING_UNSUPPORTED", "INSTRUCTION_ACCOUNTING_INCOMPLETE"]
  },
  "boundedness_gates": {
    "conditional_rule": "for every fixed D,F, max minus min over all four H values",
    "retired_instructions_H_range_max": 500000,
    "elapsed_monotonic_H_range_max_ns": 75000000,
    "peak_committed_H_range_max_bytes": 67108864,
    "total_io_transfer_H_range_max_bytes": 16777216,
    "total_io_operations_H_range_max": 4096,
    "failure": "H_SHAPE_LIMIT"
  },
  "call_ledger": {
    "schema_id": "CallLedgerV2",
    "states": ["PREPARED", "DISPATCHED", "RESPONSE_DURABLY_RECORDED", "PROVEN_PRE_ACCEPT_FAILURE", "ACCEPTANCE_AMBIGUOUS"],
    "ambiguity": "terminal whole-pair missing state; no event or runtime attestation may transition it to PREPARED or durable response",
    "retry": "forbidden in this contract; no ACCEPTANCE_AMBIGUOUS-to-retry authority exists",
    "durability": "nonempty raw response bytes/hash/ref/provider ID plus transaction, fsync, commit, and receipt digest"
  }
}
