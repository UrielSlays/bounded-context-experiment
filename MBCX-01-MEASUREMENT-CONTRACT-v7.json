    "failure": "H_SHAPE_LIMIT"
  },
  "call_ledger_and_episode": {
    "call_schema": "CallLedgerV3",
    "identity_fields": ["scenario_id", "condition", "node", "handoff_id", "task_packet_hash", "served_request_hash", "request_parameters_hash", "idempotency_token", "route_contract_hash"],
    "b_binding": "DurableBResponseBindingV1 embeds the exact full ledger and exact full B response, including transaction ID, full DurabilityReceiptV1 and its receipt hash. Any inequality is B_LEDGER_MISMATCH.",
    "ambiguity": "ACCEPTANCE_AMBIGUOUS and PROVEN_PRE_ACCEPT_FAILURE are terminal whole-pair missing states. No retry authority exists.",
    "episode": "EpisodeReceiptV1 contains exactly BC A0/B/A1 then OM A0/B/A1 as EpisodeCallV2 rows. Each row is either one terminal launched CallLedgerV3 or NOT_LAUNCHED_UPSTREAM_TERMINAL bound to the exact prior terminal ledger in the same condition. Six durable terminals mean COMPLETE_PAIR; any failure/skip means WHOLE_PAIR_MISSING. ScenarioOutcomeReceiptV2 additionally binds its two scorer graphs to this exact episode hash and all six ordered ledger/call-record identities."
  },
  "engineering_selection": {
    "hard_gate_order": ["exactness", "accounting completeness", "finite H-shape boundedness", "absolute affordability"],
    "pareto_objective_order": ["retired_instructions", "aggregate_cpu_time_ns", "elapsed_monotonic_ns", "peak_committed_bytes", "total_io_transfer_bytes", "total_io_operations"],
    "evidence_schema": "EngineeringCandidateEvidenceV1 embeds CarrierExactnessReceiptV2 plus the exact signed 100-cell envelopes and derives every gate Boolean and worst-cell metric. The exactness receipt must match the pinned suite and witness-set digests, exact signed carrier artifact digest and exact full-grid identity. Fixture conformance cannot activate production authority. Caller summaries have no authority.",
    "exactness_authority": "MBCX-01-R13-CARRIER-EXACTNESS-SUITE.json is pinned and fixture-only. Editing authority_mode, supplying arbitrary suite/witness digests, or replaying PASS across another carrier or harness build fails. The reviewed physical BUILD must supply the production exactness verifier; r13.2 contains no label-based activation path.",
    "rule": "Recompute evidence before selection and report the complete nondominated survivor set. Multiple survivors require OWNER_SELECTION_REQUIRED; owner preference is policy, never evidence."
