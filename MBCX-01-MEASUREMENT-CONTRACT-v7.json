{
  "contract_id": "MBCX-01-MEASUREMENT-CONTRACT-v7",
  "normative": true,
  "closure_revision": "r13.2",
  "cohort": {
    "motifs": 6,
    "source_scenarios_per_motif": 160,
    "retained_per_motif": 128,
    "retained_total": 768,
    "one_cut_hash_domain": "stage2-cut-r13",
    "retention_hash_domain": "stage2-retain-r13",
    "authority": "RetainedScenarioAuthorityV2 recomputes the pinned generator and selection, then binds the full byte-exact candidate, generator/source provenance, retained position, candidate hash, and retained_set_root over all 768 candidate hashes."
  },
  "grid": {
    "H": [128, 1024, 10000, 100000],
    "D": [1, 4, 16, 64, 256],
    "F": [1, 4, 16, 64, 256],
    "cells": 100,
    "integer_rule": "Exact integers; JSON/Python Booleans are rejected.",
    "identity_rule": "One signed run, candidate, candidate/carrier artifact digest, generator, harness artifact/build/configuration, host/environment, signing key, producer role, fixture kind and trust policy across all cells."
  },
  "signed_measurement_envelope": {
    "schema_id": "SignedMeasurementReceiptV1",
    "domain": "MBCX01.SIGNED-MEASUREMENT-RECEIPT.V1",
    "version": 1,
    "algorithm": "ED25519",
    "signed_preimage": ["domain", "version", "algorithm", "signing_key_id", "run_id", "cell_id", "fixture_kind", "producer_role", "trust_policy_digest", "subject_digest", "environment_digest", "receipt"],
    "anti_replay": "The run ID and exact CELL.H{H}.D{D}.F{F} identity are signed and evaluator-checked.",
    "authority_rule": "A valid signature establishes integrity and the separately pinned root's authorized producer class. It does not by itself establish that the OS facts are true. Production authority additionally requires a custody-separated root ceremony and harness provenance outside the receipt producer.",
    "trust_root": "Only MBCX-01-R13-MEASUREMENT-TRUST-ROOTS.json is consulted. Envelope-supplied keys are forbidden.",
    "retirement_rule": "R13 has no production activation path. Editing production_ready cannot retire PHYSICAL_HARNESS_UNAVAILABLE. A future reviewed implementation must verify independent key-custodian and trust-root-editor approvals, distinct roles, harness build provenance and a production signing-ceremony receipt; failure is loud."
  },
  "supported_environment": {
    "native": ["BARE_METAL_WINDOWS", "HYPER_V_ROOT_PARTITION"],
    "guest": "HYPER_V_GUEST is admitted only with an explicit signed PMU-exposure capability receipt.",
    "nested_virtualization": "unsupported and fatal",
    "abi": "WINDOWS_64BIT",
    "failure": "UNSUPPORTED_MEASUREMENT_ENVIRONMENT"
  },
  "physical_receipt": {
    "implementation_status": "PHYSICAL_HARNESS_UNAVAILABLE",
    "containment": "Create the root suspended, associate a completion port and assign it to the non-breakaway Job before resume. Signed membership binds PID plus the 64-bit ETW-published ProcessSequenceNumber for root and every descendant (AMENDMENT-3, 2026-08-16: the boot-tagged ProcessStartKey appears in no Kernel-Process payload; the historical process_start_key field-name family is retained deliberately and carries the sequence number).",
    "queries": "After the signed all-members-terminal barrier, retain NTSTATUS, information class, ABI/version, expected and returned size, raw bytes and SHA-384 for JobObjectBasicAndIoAccountingInformation (96 bytes: four LARGE_INTEGER, four DWORD, six ULONGLONG fields) and JobObjectExtendedLimitInformation (144 bytes). The fourth DWORD TotalTerminatedProcesses counts Job-limit-violation terminations, not normal exits; a clean accepted run requires zero. Membership completion instead uses signed terminal PID/start-key lifetimes plus final ActiveProcesses zero. The evaluator decodes the exact Windows 64-bit ABI and compares every governing scalar.",
    "completion": "Final active-process zero, a successful final query, and signed terminal PID/start-key lifetimes are authoritative. Completion-port message counts and the active-zero message are diagnostics only because delivery is not guaranteed.",
    "external_work": "Supervisor-owned enforcement must predate resume, deny outbound network, external compute brokers and preexisting-helper delegation, show zero endpoints, and bind policy plus validation digests.",
    "identity": "Harness artifact, build, configuration and host-environment SHA-384 digests are inside the signed preimage."
  },
  "retired_instruction_mode": {
    "status": "required; unsupported or incomplete is a hard failure, never diagnostic-only",
    "backend": "ETW_PMC_EVENT_ATTACHED_V1",
    "profile_source": "INSTRUCTIONRETIRED",
    "event_list": "CSWITCH",
    "collection_semantics": "TracePmcCounterListInfo InstructionRetired is attached to TracePmcEventListInfo CSwitch in strict mode. Sampled PmcProfile estimates and multiplexed counters are not interchangeable.",
    "attribution": "Retain ordered raw per-processor counter observations. Recompute consecutive InstructionRetired deltas at CSwitch, attribute each to outgoing OldThreadId, and join it to signed Job-member PID/start-key/TID lifetimes including terminated processes.",
    "fatal": ["INSTRUCTION_ACCOUNTING_UNSUPPORTED", "INSTRUCTION_ACCOUNTING_INCOMPLETE"]
  },
  "absolute_gates": {
    "retired_instructions_max": 3000000,
    "aggregate_cpu_time_user_plus_kernel_max_ns": 150000000,
    "elapsed_monotonic_max_ns": 300000000,
    "peak_committed_max_bytes": 201326592,
    "total_io_transfer_max_bytes": 67108864,
    "failure": "AFFORDABILITY_LIMIT"
  },
  "boundedness_gates": {
    "conditional_rule": "For every fixed D,F, max minus min across the four registered H values.",
    "retired_instructions_H_range_max": 500000,
    "aggregate_cpu_time_user_plus_kernel_H_range_max_ns": 75000000,
    "aggregate_cpu_threshold_lineage": "Frozen value restored from MBCX-01-MEASUREMENT-CONTRACT-v4.json; not selected after observing r13 data.",
    "elapsed_monotonic_H_range_max_ns": 75000000,
    "peak_committed_H_range_max_bytes": 67108864,
