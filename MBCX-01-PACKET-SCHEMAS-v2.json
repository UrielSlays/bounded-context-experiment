{
  "contract_id": "MBCX-01-PACKET-SCHEMAS-v2",
  "normative": true,
  "json_schema_draft": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SemanticId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z0-9][A-Z0-9:._/-]*$"},
    "ActionId": {"type": "string", "pattern": "^(NO_ACTION|ACT\\.[0-9A-F]{64})$"},
    "Sha384": {"type": "string", "pattern": "^[0-9A-F]{96}$"},
    "UtcTime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "SafeInteger": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
    "Cut": {
      "type": "object", "additionalProperties": false,
      "required": ["journal_seq", "knowledge_time", "valid_time"],
      "properties": {"journal_seq": {"$ref": "#/$defs/SafeInteger"}, "knowledge_time": {"$ref": "#/$defs/UtcTime"}, "valid_time": {"$ref": "#/$defs/UtcTime"}}
    },
    "FactObject": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "object_kind", "fields", "source_event_ids"],
      "properties": {
        "object_id": {"$ref": "#/$defs/SemanticId"}, "object_kind": {"const": "FACT"},
        "fields": {"type": "object", "additionalProperties": false, "required": ["subject_id", "predicate_id", "value_code", "current_event_id"], "properties": {"subject_id": {"$ref": "#/$defs/SemanticId"}, "predicate_id": {"$ref": "#/$defs/SemanticId"}, "value_code": {"$ref": "#/$defs/SemanticId"}, "current_event_id": {"$ref": "#/$defs/SemanticId"}}},
        "source_event_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/SemanticId"}}
      }
    },
    "ObligationObject": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "object_kind", "fields", "source_event_ids"],
      "properties": {
        "object_id": {"$ref": "#/$defs/SemanticId"}, "object_kind": {"const": "OBLIGATION"},
        "fields": {"type": "object", "additionalProperties": false, "required": ["scope_id", "subject_id", "owner_role", "due_at", "critical", "lifecycle", "completion_action_id", "prerequisite_obligation_ids"], "properties": {"scope_id": {"$ref": "#/$defs/SemanticId"}, "subject_id": {"$ref": "#/$defs/SemanticId"}, "owner_role": {"enum": ["CONDUCTOR", "WORKER", "WRITER"]}, "due_at": {"$ref": "#/$defs/UtcTime"}, "critical": {"type": "boolean"}, "lifecycle": {"enum": ["OPEN", "COMPLETED", "CANCELLED"]}, "completion_action_id": {"$ref": "#/$defs/SemanticId"}, "prerequisite_obligation_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/SemanticId"}}}},
        "source_event_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/SemanticId"}}
      }
    },
    "DependencyObject": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "object_kind", "fields", "source_event_ids"],
      "properties": {"object_id": {"$ref": "#/$defs/SemanticId"}, "object_kind": {"const": "DEPENDENCY"}, "fields": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "prerequisite_obligation_id", "satisfied"], "properties": {"obligation_id": {"$ref": "#/$defs/SemanticId"}, "prerequisite_obligation_id": {"$ref": "#/$defs/SemanticId"}, "satisfied": {"type": "boolean"}}}, "source_event_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/SemanticId"}}}
    },
    "HandoffObject": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "object_kind", "fields", "source_event_ids"],
      "properties": {"object_id": {"$ref": "#/$defs/SemanticId"}, "object_kind": {"const": "HANDOFF"}, "fields": {"type": "object", "additionalProperties": false, "required": ["target_obligation_id", "status", "originating_cut_hash"], "properties": {"target_obligation_id": {"$ref": "#/$defs/SemanticId"}, "status": {"enum": ["OPEN", "PROPOSED", "COMMITTED", "REJECTED", "CLOSED"]}, "originating_cut_hash": {"$ref": "#/$defs/Sha384"}}}, "source_event_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/SemanticId"}}}
    },
    "ObservationObject": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "object_kind", "fields", "source_event_ids"],
      "properties": {"object_id": {"$ref": "#/$defs/SemanticId"}, "object_kind": {"const": "OBSERVATION"}, "fields": {"type": "object", "additionalProperties": false, "required": ["observed_at", "code"], "properties": {"observed_at": {"$ref": "#/$defs/UtcTime"}, "code": {"enum": ["NO_CHANGE", "TARGET_VISIBLE", "TARGET_TERMINAL", "DEPENDENCY_BLOCKED"]}}}, "source_event_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/SemanticId"}}}
    }
  },
  "schemas": {
    "DecisionPacketV3": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "scenario_id", "cut", "objects", "action_catalog", "available_action_ids", "observation", "packet_hash"],
      "properties": {
        "schema_id": {"const": "DecisionPacketV3"}, "scenario_id": {"$ref": "#/$defs/SemanticId"}, "cut": {"$ref": "#/$defs/Cut"},
        "objects": {"type": "array", "maxItems": 64, "items": {"oneOf": [{"$ref": "#/$defs/FactObject"}, {"$ref": "#/$defs/ObligationObject"}, {"$ref": "#/$defs/DependencyObject"}, {"$ref": "#/$defs/HandoffObject"}, {"$ref": "#/$defs/ObservationObject"}]}},
        "action_catalog": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["action_id", "action_kind", "scope_id", "obligation_id"], "properties": {"action_id": {"$ref": "#/$defs/ActionId"}, "action_kind": {"enum": ["ACT_ON_OBLIGATION", "NO_ACTION"]}, "scope_id": {"$ref": "#/$defs/SemanticId"}, "obligation_id": {"$ref": "#/$defs/SemanticId"}}}},
        "available_action_ids": {"type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/ActionId"}},
        "observation": {"type": "object", "additionalProperties": false, "required": ["observed_at", "code"], "properties": {"observed_at": {"$ref": "#/$defs/UtcTime"}, "code": {"enum": ["NO_CHANGE", "TARGET_VISIBLE", "TARGET_TERMINAL", "DEPENDENCY_BLOCKED"]}}},
        "packet_hash": {"$ref": "#/$defs/Sha384"}
      }
    },
    "A0ResultV1": {
      "type": "object", "additionalProperties": false, "required": ["schema_id", "input_packet_hash", "selected_action_id"],
      "properties": {"schema_id": {"const": "A0ResultV1"}, "input_packet_hash": {"$ref": "#/$defs/Sha384"}, "selected_action_id": {"$ref": "#/$defs/ActionId"}}
    },
    "TaskPacketV3": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "scenario_id", "scope_id", "target_obligation_id", "target_action_id", "input_packet_hash", "originating_cut", "originating_cut_hash", "idempotency_key", "available_action_ids", "issued_at", "packet_hash"],
      "properties": {"schema_id": {"const": "TaskPacketV3"}, "scenario_id": {"$ref": "#/$defs/SemanticId"}, "scope_id": {"$ref": "#/$defs/SemanticId"}, "target_obligation_id": {"$ref": "#/$defs/SemanticId"}, "target_action_id": {"$ref": "#/$defs/ActionId"}, "input_packet_hash": {"$ref": "#/$defs/Sha384"}, "originating_cut": {"$ref": "#/$defs/Cut"}, "originating_cut_hash": {"$ref": "#/$defs/Sha384"}, "idempotency_key": {"$ref": "#/$defs/SemanticId"}, "available_action_ids": {"type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/ActionId"}}, "issued_at": {"$ref": "#/$defs/UtcTime"}, "packet_hash": {"$ref": "#/$defs/Sha384"}}
    },
    "WorkerHandoffV3": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "scenario_id", "scope_id", "input_packet_hash", "status_code", "proposed_action_ids", "evidence_event_ids", "unresolved_item_codes", "warning_codes", "produced_at"],
      "properties": {"schema_id": {"const": "WorkerHandoffV3"}, "scenario_id": {"$ref": "#/$defs/SemanticId"}, "scope_id": {"$ref": "#/$defs/SemanticId"}, "input_packet_hash": {"$ref": "#/$defs/Sha384"}, "status_code": {"enum": ["PROPOSE", "ABSTAIN", "REJECT"]}, "proposed_action_ids": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/ActionId"}}, "evidence_event_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/SemanticId"}}, "unresolved_item_codes": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["MISSING_EVIDENCE", "AMBIGUOUS_SCOPE", "DEPENDENCY_UNRESOLVED", "FRONTIER_LIMIT"]}}, "warning_codes": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["STALE_INPUT", "CONFLICT_PRESENT", "PARTIAL_EVIDENCE", "TRANSPORT_METADATA_MISSING"]}}, "produced_at": {"$ref": "#/$defs/UtcTime"}},
      "allOf": [
        {"if": {"properties": {"status_code": {"const": "PROPOSE"}}}, "then": {"properties": {"proposed_action_ids": {"minItems": 1}}}},
        {"if": {"properties": {"status_code": {"enum": ["ABSTAIN", "REJECT"]}}}, "then": {"properties": {"proposed_action_ids": {"maxItems": 0}}}}
      ]
    },
    "A1ResultV1": {
      "type": "object", "additionalProperties": false, "required": ["schema_id", "input_packet_hash", "selected_action_ids"],
      "properties": {"schema_id": {"const": "A1ResultV1"}, "input_packet_hash": {"$ref": "#/$defs/Sha384"}, "selected_action_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/ActionId"}}}
    }
  },
  "hashing": {
    "packet_hash_preimage": "the complete schema-valid packet object with packet_hash member omitted",
    "algorithm": "uppercase SHA-384 over RFC8785/JCS UTF-8 bytes",
    "no_separate_outer_key_order": true,
    "served_input_hash": "uppercase SHA-384 over exact padded bytes sent to provider"
  },
  "renderer": {
    "fixed_byte_envelope": 65536,
    "maximum_schema_valid_packet_bytes_must_be_below_envelope": true,
    "padding": "append U+0020 outside packet_hash and inside served_input_hash",
    "instructions_id": "MBCX01-STAGE2-SYSTEM-v3",
    "descriptions_id": "MBCX01-STAGE2-FIELDS-v3",
    "maximum_output_tokens": 512,
    "transport_settings": {"temperature": 0, "top_p": 1, "tools": "none", "response_format": "strict schema"},
    "condition_excluded_from_served_packet": true
  },
  "conductor": {
    "task_packet_builder": "deterministic conductor code resolves A0 selected_action_id through action_catalog and builds TaskPacketV3; A0 never emits TaskPacketV3",
    "ordering": "objects and action_catalog by UTF8 object/action ID; selected sets by UTF8 action ID"
  },
  "scorer": {
    "A0_correct": "schema-valid A0ResultV1 selected_action_id equals unique frozen gold action",
    "B_correct": "schema-valid WorkerHandoffV3 PROPOSE commits the target action exactly once",
    "A1_correct": "schema-valid A1ResultV1 selected set equals independently recomputed post-commit gold set",
    "condition_success": "A0_correct AND B_correct AND A1_correct",
    "schema_invalid_output": "condition failure, not transport missingness",
    "BC_OM_pair": "two binary condition_success values"
  },
  "red_witnesses": ["OPEN_FIELDS_OBJECT", "STATUS_ACTION_CONTRADICTION", "MODEL_BUILT_TASK_PACKET", "PACKET_HASH_PREIMAGE_CONFLICT", "CONDITION_LABEL_LEAK", "MAX_PACKET_OVERFLOW"]
}
