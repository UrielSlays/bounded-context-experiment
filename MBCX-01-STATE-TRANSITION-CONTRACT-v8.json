{
  "contract_id": "MBCX-01-STATE-TRANSITION-CONTRACT-v8",
  "normative": true,
  "event_types": [
    "assert_fact", "correct_fact", "retract_fact", "open_obligation",
    "reschedule_obligation", "delegate_obligation", "complete_obligation",
    "cancel_obligation", "reopen_obligation", "link_dependency",
    "unlink_dependency", "open_handoff", "record_call_response",
    "propose_handoff_result", "commit_handoff_result",
    "reject_handoff_result", "close_handoff"
  ],
  "schema_ingress": {
    "shared": "structural/hash/schema primitives only: closed envelope and payload admission plus canonical bytes, hashes, IDs, and receipt shape; no replay, idempotency, persistence, sequence, last-observed, or effect finalization semantics",
    "independence_boundary": "AFTER_SHARED_SCHEMA_VALIDATION",
    "post_ingress": "reference and oracle independently implement every semantic guard and effect, including replay, idempotency, event persistence, next_seq, last_observed_at, temporal visibility and closure, dependency reachability, action legality, and transition decisions; neither reducer invokes the other's semantics and neither invokes shared post-admission semantics",
    "executable_witness": "I15 tests remove and poison shared finalization names, perturb each reducer-local replay/finalizer independently, and retain byte-identical baseline results across the full 17-event legal matrix"
  },
  "originating_cut": {
    "new_event_rule": "journal_seq must equal current next_seq and originating_cut must equal current_cut(state, chosen valid_time): journal_seq=next_seq-1 and knowledge_time=max(T1,last_observed_at)",
    "replay_exception": "an exact previously applied event is DUPLICATE_NOOP",
    "purpose": "prevents stale/backdated or stale-knowledge mutation while preserving historical cut answers"
  },
  "facts": {
    "intervals": "half-open, nonempty, and nonoverlapping among currently known unsuperseded versions",
    "correction": "strictly inside the cut-relative parent interval and never beyond its old upper bound",
    "history": "closure and retraction are append-only knowledge-time evidence; old rows are never mutated"
  },
  "responses": {
    "causal_rule": "one exact durable B response after the matching open same-scope handoff",
    "uniqueness": "distinct response events remain distinct rows; duplicate logical identity conflicts",
    "proposal": "requires exactly one complete B foreign-key match",
    "commit": "rechecks current target legality and unchanged originating target state",
    "rejection": "requires an existing PROPOSED handoff and proposal_hash equal to the persisted SHA-384 hash of that exact proposal event"
  },
  "state_authority": {
    "schema_id": "StateAuthorityReceiptV1",
    "fixture_mode": "FIXTURE_ONLY_UNAVAILABLE",
    "fixture_producer_id": "MBCX01.R13.FIXTURE.STATE.OWNER",
    "production_state_owner_adapter": null,
    "production_trust_root": null,
    "production_ready": false,
    "conformance_api": "verify_state_authority_receipt(receipt, require_production=false)",
    "scientific_admission_api": "verify_state_authority_receipt(receipt, require_production=true)",
    "scientific_admission_rule": "STATE_AUTHORITY_UNAVAILABLE is mandatory until an independently configured production state-owner adapter and trust root exist; a fixture-only receipt can never create an experiment-eligible graph score",
    "fixture_constructor": "mbcx01_r13_state_reference.make_fixture_state_authority_receipt"
  },
  "state_authority_invariants": [
    {"id": "SA-01", "rule": "shared common code owns structural/hash/schema admission only and exports no replay, idempotency, event persistence, next_seq, last_observed_at, or effect finalizer"},
    {"id": "SA-02", "rule": "reference and oracle independently decide exact-event replay and event-ID conflict"},
    {"id": "SA-03", "rule": "reference and oracle independently derive the idempotency slot and semantic preimage and decide duplicate versus conflict"},
    {"id": "SA-04", "rule": "each reducer independently persists the exact canonical event hash after and only after APPLIED"},
    {"id": "SA-05", "rule": "each reducer independently advances next_seq to applied journal_seq plus one"},
    {"id": "SA-06", "rule": "each reducer independently advances last_observed_at to the applied event observation time"},
    {"id": "SA-07", "rule": "a receipt binds one exact store ID, namespace, and namespace version"},
    {"id": "SA-08", "rule": "a receipt binds one immutable transaction_commit_id and deterministic pre/post read IDs"},
    {"id": "SA-09", "rule": "prestate readback binds canonical state UTF-8 bytes, SHA-384, and the exact current cut"},
    {"id": "SA-10", "rule": "proposal persistence binds canonical proposal event bytes, event ID, SHA-384, and an exact matching entry already present in the prestate event table"},
    {"id": "SA-11", "rule": "the applied child binds canonical event bytes, event ID, SHA-384, and must be an admissible commit or rejection of the persisted proposal"},
    {"id": "SA-12", "rule": "postcommit readback binds canonical state UTF-8 bytes, SHA-384, and the exact current cut"},
    {"id": "SA-13", "rule": "reference and oracle independently replay the child from the exact prestate and must each reproduce the exact postcommit readback"},
    {"id": "SA-14", "rule": "production authority requires an independently configured state-owner adapter, trust root, signer identity, algorithm, and valid signature; none exists in R13"},
    {"id": "SA-15", "rule": "fixture producer identity is explicit and all signer/trust/signature fields are null; production or scientific admission fails loud with STATE_AUTHORITY_UNAVAILABLE"}
  ],
  "state_authority_receipt_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://moonwalker.local/schema/mbcx01/r13/state-authority-receipt-v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_id", "authority_mode", "store_identity", "transaction_commit_id", "prestate_read", "proposal_persistence", "applied_child", "postcommit_readback", "authority_identity", "receipt_hash"],
    "properties": {
      "schema_id": {"const": "StateAuthorityReceiptV1"},
      "authority_mode": {"const": "FIXTURE_ONLY_UNAVAILABLE"},
      "store_identity": {"type": "object", "additionalProperties": false, "required": ["store_id", "namespace", "namespace_version"], "properties": {"store_id": {"const": "STORE.MBCX01.FIXTURE"}, "namespace": {"const": "MBCX01.STATE"}, "namespace_version": {"const": 1}}},
      "transaction_commit_id": {"$ref": "#/$defs/semanticId"},
      "prestate_read": {"$ref": "#/$defs/stateRead"},
      "proposal_persistence": {"$ref": "#/$defs/eventBytes"},
      "applied_child": {"$ref": "#/$defs/eventBytes"},
      "postcommit_readback": {"$ref": "#/$defs/stateRead"},
      "authority_identity": {"type": "object", "additionalProperties": false, "required": ["producer_id", "signer_key_id", "trust_root_id", "signature_algorithm", "signature"], "properties": {"producer_id": {"const": "MBCX01.R13.FIXTURE.STATE.OWNER"}, "signer_key_id": {"type": "null"}, "trust_root_id": {"type": "null"}, "signature_algorithm": {"type": "null"}, "signature": {"type": "null"}}},
      "receipt_hash": {"$ref": "#/$defs/sha384"}
    },
    "$defs": {
      "semanticId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9:._/-]{0,127}$"},
      "sha384": {"type": "string", "pattern": "^[0-9A-F]{96}$"},
      "utc": {"type": "string", "format": "moonwalker-utc", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
      "cut": {"type": "object", "additionalProperties": false, "required": ["journal_seq", "knowledge_time", "valid_time"], "properties": {"journal_seq": {"type": "integer", "minimum": 0}, "knowledge_time": {"$ref": "#/$defs/utc"}, "valid_time": {"$ref": "#/$defs/utc"}}},
      "stateRead": {"type": "object", "additionalProperties": false, "required": ["read_id", "state_utf8", "state_hash", "cut"], "properties": {"read_id": {"$ref": "#/$defs/semanticId"}, "state_utf8": {"type": "string", "minLength": 1}, "state_hash": {"$ref": "#/$defs/sha384"}, "cut": {"$ref": "#/$defs/cut"}}},
      "eventBytes": {"type": "object", "additionalProperties": false, "required": ["event_id", "event_utf8", "event_hash"], "properties": {"event_id": {"type": "string", "pattern": "^EV\\.[0-9A-F]{64}$"}, "event_utf8": {"type": "string", "minLength": 1}, "event_hash": {"$ref": "#/$defs/sha384"}}}
    }
  },
  "event_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://moonwalker.local/schema/mbcx01/r13/event-envelope-v8",
    "type": "object",
    "additionalProperties": false,
    "required": ["event_id", "scope_id", "event_type", "semantic_operation", "idempotency_key", "journal_seq", "observed_at", "valid_from", "valid_to", "originating_cut", "payload"],
    "properties": {
      "event_id": {"type": "string", "pattern": "^EV\\.[0-9A-F]{64}$"},
      "scope_id": {"$ref": "#/$defs/semanticId"},
      "event_type": {"enum": ["assert_fact", "correct_fact", "retract_fact", "open_obligation", "reschedule_obligation", "delegate_obligation", "complete_obligation", "cancel_obligation", "reopen_obligation", "link_dependency", "unlink_dependency", "open_handoff", "record_call_response", "propose_handoff_result", "commit_handoff_result", "reject_handoff_result", "close_handoff"]},
      "semantic_operation": {"type": "string"},
      "idempotency_key": {"$ref": "#/$defs/semanticId"},
      "journal_seq": {"type": "integer", "minimum": 0},
      "observed_at": {"$ref": "#/$defs/utc"},
      "valid_from": {"$ref": "#/$defs/utc"},
      "valid_to": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
      "originating_cut": {"$ref": "#/$defs/cut"},
      "payload": {"type": "object"}
    },
    "allOf": [
      {"if": {"properties": {"event_type": {"const": "assert_fact"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/assertFact"}}}},
      {"if": {"properties": {"event_type": {"const": "correct_fact"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/correctFact"}}}},
      {"if": {"properties": {"event_type": {"const": "retract_fact"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/retractFact"}}}},
      {"if": {"properties": {"event_type": {"const": "open_obligation"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/openObligation"}}}},
      {"if": {"properties": {"event_type": {"const": "reschedule_obligation"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/rescheduleObligation"}}}},
      {"if": {"properties": {"event_type": {"const": "delegate_obligation"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/delegateObligation"}}}},
      {"if": {"properties": {"event_type": {"const": "complete_obligation"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/completeObligation"}}}},
      {"if": {"properties": {"event_type": {"const": "cancel_obligation"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/cancelObligation"}}}},
      {"if": {"properties": {"event_type": {"const": "reopen_obligation"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/reopenObligation"}}}},
      {"if": {"properties": {"event_type": {"const": "link_dependency"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/dependency"}}}},
      {"if": {"properties": {"event_type": {"const": "unlink_dependency"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/dependency"}}}},
      {"if": {"properties": {"event_type": {"const": "open_handoff"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/openHandoff"}}}},
      {"if": {"properties": {"event_type": {"const": "record_call_response"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/callResponse"}}}},
      {"if": {"properties": {"event_type": {"const": "propose_handoff_result"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/proposal"}}}},
      {"if": {"properties": {"event_type": {"const": "commit_handoff_result"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/commit"}}}},
      {"if": {"properties": {"event_type": {"const": "reject_handoff_result"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/reject"}}}},
      {"if": {"properties": {"event_type": {"const": "close_handoff"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/close"}}}}
    ],
    "$defs": {
      "semanticId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9:._/-]{0,127}$"},
      "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
      "sha384": {"type": "string", "pattern": "^[0-9A-F]{96}$"},
      "utc": {"type": "string", "format": "moonwalker-utc", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
      "cut": {"type": "object", "additionalProperties": false, "required": ["journal_seq", "knowledge_time", "valid_time"], "properties": {"journal_seq": {"type": "integer", "minimum": 0}, "knowledge_time": {"$ref": "#/$defs/utc"}, "valid_time": {"$ref": "#/$defs/utc"}}},
      "actionCatalog": {"type": "array", "minItems": 1, "items": {"oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["action_id", "obligation_id"], "properties": {"action_id": {"type": "string", "pattern": "^ACT\\.[0-9A-F]{64}$"}, "obligation_id": {"$ref": "#/$defs/semanticId"}}},
        {"type": "object", "additionalProperties": false, "required": ["action_id", "action_kind", "scope_id", "obligation_id"], "properties": {"action_id": {"type": "string", "pattern": "^ACT\\.[0-9A-F]{64}$"}, "action_kind": {"const": "ACT_ON_OBLIGATION"}, "scope_id": {"$ref": "#/$defs/semanticId"}, "obligation_id": {"$ref": "#/$defs/semanticId"}}},
        {"type": "object", "additionalProperties": false, "required": ["action_id", "action_kind"], "properties": {"action_id": {"const": "NO_ACTION"}, "action_kind": {"const": "NO_ACTION"}}}
      ]}},
      "assertFact": {"type": "object", "additionalProperties": false, "required": ["subject_id", "predicate_id", "value_code"], "properties": {"subject_id": {"$ref": "#/$defs/semanticId"}, "predicate_id": {"$ref": "#/$defs/semanticId"}, "value_code": {"$ref": "#/$defs/semanticId"}}},
      "correctFact": {"type": "object", "additionalProperties": false, "required": ["subject_id", "predicate_id", "parent_event_id", "value_code"], "properties": {"subject_id": {"$ref": "#/$defs/semanticId"}, "predicate_id": {"$ref": "#/$defs/semanticId"}, "parent_event_id": {"type": "string"}, "value_code": {"$ref": "#/$defs/semanticId"}}},
      "retractFact": {"type": "object", "additionalProperties": false, "required": ["subject_id", "predicate_id", "target_event_id"], "properties": {"subject_id": {"$ref": "#/$defs/semanticId"}, "predicate_id": {"$ref": "#/$defs/semanticId"}, "target_event_id": {"type": "string"}}},
      "openObligation": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "subject_id", "owner_role", "due_at", "critical", "completion_action_id", "prerequisite_obligation_ids"], "properties": {"obligation_id": {"$ref": "#/$defs/semanticId"}, "subject_id": {"$ref": "#/$defs/semanticId"}, "owner_role": {"$ref": "#/$defs/semanticId"}, "due_at": {"$ref": "#/$defs/utc"}, "critical": {"type": "boolean"}, "completion_action_id": {"type": "string", "pattern": "^ACT\\.[0-9A-F]{64}$"}, "prerequisite_obligation_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/semanticId"}}}},
      "rescheduleObligation": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "due_at"], "properties": {"obligation_id": {"$ref": "#/$defs/semanticId"}, "due_at": {"$ref": "#/$defs/utc"}}},
      "delegateObligation": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "owner_role"], "properties": {"obligation_id": {"$ref": "#/$defs/semanticId"}, "owner_role": {"$ref": "#/$defs/semanticId"}}},
      "completeObligation": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "completion_action_id", "originating_cut_hash"], "properties": {"obligation_id": {"$ref": "#/$defs/semanticId"}, "completion_action_id": {"type": "string", "pattern": "^ACT\\.[0-9A-F]{64}$"}, "originating_cut_hash": {"$ref": "#/$defs/sha384"}}},
      "cancelObligation": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "cancellation_code"], "properties": {"obligation_id": {"$ref": "#/$defs/semanticId"}, "cancellation_code": {"$ref": "#/$defs/semanticId"}}},
      "reopenObligation": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "due_at", "owner_role"], "properties": {"obligation_id": {"$ref": "#/$defs/semanticId"}, "due_at": {"$ref": "#/$defs/utc"}, "owner_role": {"$ref": "#/$defs/semanticId"}}},
      "dependency": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "prerequisite_obligation_id"], "properties": {"obligation_id": {"$ref": "#/$defs/semanticId"}, "prerequisite_obligation_id": {"$ref": "#/$defs/semanticId"}}},
      "openHandoff": {"type": "object", "additionalProperties": false, "required": ["handoff_id", "scenario_id", "condition", "target_obligation_id", "task_packet_hash", "served_request_hash", "request_parameters_hash", "idempotency_token", "task_packet_utf8", "manifest_utf8", "originating_cut_hash", "action_catalog_hash", "canonical_snapshot_hash", "route_contract_hash", "manifest_hash", "action_catalog"], "properties": {"handoff_id": {"$ref": "#/$defs/semanticId"}, "scenario_id": {"$ref": "#/$defs/semanticId"}, "condition": {"enum": ["BC", "OM"]}, "target_obligation_id": {"$ref": "#/$defs/semanticId"}, "task_packet_hash": {"$ref": "#/$defs/sha384"}, "served_request_hash": {"$ref": "#/$defs/sha256"}, "request_parameters_hash": {"$ref": "#/$defs/sha384"}, "idempotency_token": {"$ref": "#/$defs/semanticId"}, "task_packet_utf8": {"type": "string", "minLength": 1}, "manifest_utf8": {"type": "string", "minLength": 1}, "originating_cut_hash": {"$ref": "#/$defs/sha384"}, "action_catalog_hash": {"$ref": "#/$defs/sha384"}, "canonical_snapshot_hash": {"$ref": "#/$defs/sha384"}, "route_contract_hash": {"$ref": "#/$defs/sha384"}, "manifest_hash": {"$ref": "#/$defs/sha384"}, "action_catalog": {"$ref": "#/$defs/actionCatalog"}}},
      "durability": {"type": "object", "additionalProperties": false, "required": ["schema_id", "ledger_identity_hash", "raw_response_hash", "response_ref", "provider_request_id", "transaction_id", "fsync_completed", "commit_completed", "receipt_hash"], "properties": {"schema_id": {"const": "DurabilityReceiptV1"}, "ledger_identity_hash": {"$ref": "#/$defs/sha384"}, "raw_response_hash": {"$ref": "#/$defs/sha384"}, "response_ref": {"$ref": "#/$defs/semanticId"}, "provider_request_id": {"$ref": "#/$defs/semanticId"}, "transaction_id": {"$ref": "#/$defs/semanticId"}, "fsync_completed": {"const": true}, "commit_completed": {"const": true}, "receipt_hash": {"$ref": "#/$defs/sha384"}}},
      "callResponse": {"type": "object", "additionalProperties": false, "required": ["handoff_id", "scenario_id", "condition", "node", "task_packet_hash", "served_request_hash", "request_parameters_hash", "idempotency_token", "raw_response_utf8", "raw_response_hash", "worker_handoff_hash", "response_ref", "provider_request_id", "durability_receipt", "route_contract_hash", "accepted_at"], "properties": {"handoff_id": {"$ref": "#/$defs/semanticId"}, "scenario_id": {"$ref": "#/$defs/semanticId"}, "condition": {"enum": ["BC", "OM"]}, "node": {"const": "B"}, "task_packet_hash": {"$ref": "#/$defs/sha384"}, "served_request_hash": {"$ref": "#/$defs/sha256"}, "request_parameters_hash": {"$ref": "#/$defs/sha384"}, "idempotency_token": {"$ref": "#/$defs/semanticId"}, "raw_response_utf8": {"type": "string", "minLength": 1}, "raw_response_hash": {"$ref": "#/$defs/sha384"}, "worker_handoff_hash": {"$ref": "#/$defs/sha384"}, "response_ref": {"$ref": "#/$defs/semanticId"}, "provider_request_id": {"$ref": "#/$defs/semanticId"}, "durability_receipt": {"$ref": "#/$defs/durability"}, "route_contract_hash": {"$ref": "#/$defs/sha384"}, "accepted_at": {"$ref": "#/$defs/utc"}}},
      "proposal": {"type": "object", "additionalProperties": false, "required": ["handoff_id", "worker_handoff_hash", "originating_cut_hash", "action_ids"], "properties": {"handoff_id": {"$ref": "#/$defs/semanticId"}, "worker_handoff_hash": {"$ref": "#/$defs/sha384"}, "originating_cut_hash": {"$ref": "#/$defs/sha384"}, "action_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ACT\\.[0-9A-F]{64}$"}}}},
      "commit": {"type": "object", "additionalProperties": false, "required": ["handoff_id", "proposal_event_id"], "properties": {"handoff_id": {"$ref": "#/$defs/semanticId"}, "proposal_event_id": {"type": "string", "pattern": "^EV\\.[0-9A-F]{64}$"}}},
      "reject": {"type": "object", "additionalProperties": false, "required": ["handoff_id", "rejection_code", "proposal_hash"], "properties": {"handoff_id": {"$ref": "#/$defs/semanticId"}, "rejection_code": {"$ref": "#/$defs/semanticId"}, "proposal_hash": {"$ref": "#/$defs/sha384"}}},
      "close": {"type": "object", "additionalProperties": false, "required": ["handoff_id"], "properties": {"handoff_id": {"$ref": "#/$defs/semanticId"}}}
    }
  }
}
